{
  "name": "caffeine-tracker",
  "productName": "Caffeine Tracker",
  "version": "1.0.0",
  "description": "Desktop app for logging caffeine intake and estimating how much is still in your system.",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.campbellchase.caffeinetracker",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    }
  },
  "devDependencies": {
    "electron": "44.5.0",
    "electron-builder": "26.17.0"
  }
}
